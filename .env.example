# Секретные значения храните только в локальном .env или защищённых настройках хостинга.
# Для Mail.ru нужен пароль приложения; не отправляйте его в чат и не добавляйте в Git.
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=petrochenko_s@stoolgroup.ru
SMTP_PASSWORD=
MAIL_FROM=
# Альтернативный почтовый транспорт: MAIL_TRANSPORT=resend
# RESEND_API_KEY=
PORT=3000
HOST=0.0.0.0
# Автоматически проверять новые цены и остатки (0 отключает синхронизацию).
CATALOG_AUTO_SYNC=1
# Публичный адрес лендинга для письма-подтверждения после запуска сайта.
PUBLIC_SITE_URL=
